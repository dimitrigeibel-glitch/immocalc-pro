# Google OAuth – aus der Google Cloud Console
# 1. Projekt anlegen: https://console.cloud.google.com
# 2. Gmail API aktivieren
# 3. OAuth 2.0 Credentials erstellen: Web Application + iOS (Bundle: com.dimitrigeibel.voicemail)
# 4. Scopes: gmail.readonly + gmail.send
GOOGLE_WEB_CLIENT_ID=DEINE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=DEINE_IOS_CLIENT_ID.apps.googleusercontent.com

# Anthropic Claude API – aus https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Expo EAS – nach `npx eas init` automatisch befüllt
EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
